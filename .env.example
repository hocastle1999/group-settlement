# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. (.env는 git에 올라가지 않습니다)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=group_settlement
DB_USER=group_settlement_app
# scripts/init_db.sql에 넣은 비밀번호와 같은 값
DB_PASSWORD=change-me

# 정산 AUTO가 최적(비트마스크 DP)을 쓰는 최대 인원 (1 ~ 20, 기본 16). 서버가 느리면 낮춘다.
SETTLE_OPTIMAL_LIMIT=16

# 쓰기 빈도 제한 (접속자 IP마다, 0이면 끔)
RATE_LIMIT_GROUPS_PER_HOUR=10
RATE_LIMIT_WRITES_PER_MINUTE=60
# 앞단 프록시 수: 로컬 0, Render 1 (X-Forwarded-For를 오른쪽에서 이만큼 센 값을 접속자 IP로 본다)
TRUSTED_PROXY_HOPS=0
